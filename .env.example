# Environment Variables Template
# Copy this file to .env and fill in actual values
# NEVER commit .env to Git!

# ============================================
# DATABASE CONFIGURATION
# ============================================
JAVA_DB_USERNAME=postgres
JAVA_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
postgres_db=dev

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate with: openssl rand -base64 64
JAVA_JWT_SECRET=CHANGE_ME_256_BIT_SECRET_KEY_MIN_LENGTH_IS_VERY_IMPORTANT_FOR_SECURITY

# ============================================
# ERPNEXT INTEGRATION
# ============================================
ERPNEXT_API_URL=https://your-erpnext-instance.com/api/resource
ERPNEXT_API_KEY=your_erpnext_api_key
ERPNEXT_API_SECRET=your_erpnext_api_secret

# ============================================
# PAYMENT GATEWAY - RAZORPAY
# ============================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================
# SHIPPING - SHIPROCKET
# ============================================
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# ============================================
# OBJECT STORAGE - MINIO
# ============================================
MINIO_ENDPOINT_DOCKER=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=fashion-store

# ============================================
# MESSAGE BROKER - RABBITMQ
# ============================================
RABBITMQ_USER=admin
RABBITMQ_PASS=CHANGE_ME_RABBITMQ_PASSWORD

# ============================================
# MARKETING AUTOMATION - DITTOFEED
# ============================================
DITTOFEED_API_URL=https://your-dittofeed-instance.com
DITTOFEED_API_KEY=your_dittofeed_api_key

# ============================================
# CACHE - REDIS
# ============================================
REDIS_HOST_DOCKER=redis
REDIS_PORT=6379

# ============================================
# SERVICE DISCOVERY - EUREKA
# ============================================
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery-server:8761/eureka

# ============================================
# OBSERVABILITY - SKYWALKING
# ============================================
SW_OAP_ADDRESS=skywalking-oap:11800
SW_LOGGING_LEVEL=INFO

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_ROOT=../ecommerce-backups

# ============================================
# MARKETPLACE WEBHOOKS (Optional)
# ============================================
AMAZON_WEBHOOK_SECRET=mock-amazon
FLIPKART_WEBHOOK_SECRET=mock-flipkart
ONDC_WEBHOOK_SECRET=mock-ondc

# ============================================
# PRODUCTION DEPLOYMENT (Set these in prod)
# ============================================
# DEPLOYMENT_ENV=production
# LOG_LEVEL=WARN
# SPRING_PROFILES_ACTIVE=prod

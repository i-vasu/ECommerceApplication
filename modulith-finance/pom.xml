<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.app</groupId>
		<artifactId>fashion-store-parent</artifactId>
		<version>0.0.2-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>modulith-finance</artifactId>
	<name>modulith-finance</name>
	<description>Finance, Payments and Taxation</description>

	<dependencies>
		<dependency>
			<groupId>com.app</groupId>
			<artifactId>modulith-kernel</artifactId>
            <version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.app</groupId>
			<artifactId>modulith-catalog</artifactId>
            <version>${project.version}</version>
            </dependency>
		<dependency>
			<groupId>com.app</groupId>
			<artifactId>modulith-logistics</artifactId>
            <version>${project.version}</version>
            </dependency>
		<dependency>
			<groupId>com.app</groupId>
			<artifactId>modulith-governance</artifactId>
            <version>${project.version}</version>
            </dependency>
		<dependency>
			<groupId>com.app</groupId>
			<artifactId>modulith-security</artifactId>
            <version>${project.version}</version>
            </dependency>
		<dependency>
			<groupId>com.razorpay</groupId>
			<artifactId>razorpay-java</artifactId>
			<version>1.4.6</version>
		</dependency>
		<dependency>
			<groupId>io.github.juspay.hyperswitch</groupId>
			<artifactId>hyperswitch-java-client</artifactId>
			<version>0.0.4</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>
	
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
